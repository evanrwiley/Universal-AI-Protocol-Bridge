{
  "name": "universal-ai-protocol-bridge",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "private": false,
  "scripts": {
    "build": "npm run build:ui && npm run type-check",
    "build:ui": "vite build",
    "dev": "wrangler dev",
    "deploy": "npm run build:ui && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.101.0"
  }
}
